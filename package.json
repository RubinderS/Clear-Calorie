{
  "name": "clearcalorie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env TZ=UTC next dev",
    "build": "cross-env TZ=UTC next build",
    "start": "cross-env TZ=UTC next start",
    "lint": "eslint",
    "test": "tsx --test lib/*.test.ts lib/chat/*.test.ts",
    "test:e2e": "cross-env TZ=UTC next build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "migrate-mongo up",
    "db:migrate:status": "migrate-mongo status",
    "db:migrate:down": "migrate-mongo down",
    "db:migrate:create": "migrate-mongo create",
    "db:seed": "cross-env TZ=UTC tsx --env-file=.env scripts/seed.ts",
    "db:reset": "cross-env TZ=UTC tsx --env-file=.env scripts/reset-db.ts && npm run db:seed",
    "db:migrate-from-sqlite": "node scripts/migrate-sqlite-to-mongo.mjs",
    "reports:generate": "cross-env TZ=UTC tsx --env-file=.env scripts/generate-weekly-reports.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.483.0",
    "migrate-mongo": "14.0.7",
    "mongoose": "9.11.1",
    "nanoid": "6.0.1",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.15.1",
    "resend": "6.30.0",
    "tailwind-merge": "^3.0.2",
    "three": "0.186.1",
    "tone": "15.1.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
