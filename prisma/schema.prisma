generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  foods         FoodLog[]
  savedFoods    SavedFoodItem[]
  exercises     ExerciseLog[]
  savedExercises SavedExerciseItem[]
  exerciseGoals ExerciseGoal[]
  weights       WeightLog[]
  goals         Goal?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FoodLog {
  id           String   @id @default(cuid())
  userId       String
  name         String
  calories     Float
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  saturatedFat Float    @default(0)
  loggedAt     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SavedFoodItem {
  id           String   @id @default(cuid())
  userId       String
  name         String
  calories     Float
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  saturatedFat Float    @default(0)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ExerciseLog {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("TIME")
  calories    Int
  durationMin Int      @default(0)
  sets        Int?
  reps        Int?
  weight      Float?
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Set when the entry was ticked off from a planned exercise goal
  exerciseGoalId String?
  // User-local yyyy-MM-dd the goal was ticked for; one tick per goal per day
  goalDate       String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseGoal ExerciseGoal? @relation(fields: [exerciseGoalId], references: [id], onDelete: SetNull)

  @@unique([exerciseGoalId, goalDate])
  @@index([userId, loggedAt])
}

model SavedExerciseItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("TIME")
  calories    Int
  durationMin Int      @default(0)
  sets        Int?
  reps        Int?
  weight      Float?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ExerciseGoal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("TIME")
  calories    Int      @default(0)
  durationMin Int?
  sets        Int?
  reps        Int?
  weight      Float?
  // Bit n set = active on JS getDay() n (0 = Sunday)
  daysMask    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs ExerciseLog[]

  @@index([userId])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model Goal {
  id               String  @id @default(cuid())
  userId           String  @unique
  calorieGoal      Int     @default(2000)
  proteinGoal      Int     @default(150)
  carbsGoal        Int     @default(250)
  fatGoal          Int     @default(70)
  saturatedFatGoal Int     @default(20)
  weightGoal       Float?
  healthNotes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
