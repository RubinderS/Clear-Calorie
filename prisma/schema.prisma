generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  // Browser-detected IANA timezone, saved so server jobs know the user's local week
  timeZone      String?
  // Last dashboard visit, updated at most hourly
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  foods            FoodLog[]
  savedFoods       SavedFoodItem[]
  exercises        ExerciseLog[]
  savedExercises   SavedExerciseItem[]
  exerciseGoals    ExerciseGoal[]
  exercisePlanDays ExercisePlanDay[]
  weights          WeightLog[]
  goals            Goal?
  weeklyReports    WeeklyReport[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FoodLog {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  calories           Float
  protein            Float    @default(0)
  carbs              Float    @default(0)
  fat                Float    @default(0)
  saturatedFat       Float    @default(0)
  // AI health alert shown when the entry was estimated ("caution" | "avoid")
  healthAlertLevel   String?
  healthAlertMessage String?
  loggedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SavedFoodItem {
  id           String   @id @default(cuid())
  userId       String
  name         String
  calories     Float
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  saturatedFat Float    @default(0)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ExerciseLog {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String   @default("TIME")
  calories       Int
  durationMin    Int      @default(0)
  sets           Int?
  reps           Int?
  weight         Float?
  loggedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Set when the entry was ticked off from a planned exercise goal
  exerciseGoalId String?
  // User-local yyyy-MM-dd the goal was ticked for; one tick per goal per day
  goalDate       String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseGoal ExerciseGoal? @relation(fields: [exerciseGoalId], references: [id], onDelete: SetNull)
  // Strength sets as done; sets/reps/weight above summarize them (count and top set)
  exerciseSets ExerciseSet[]

  @@unique([exerciseGoalId, goalDate])
  @@index([userId, loggedAt])
}

model ExerciseSet {
  id            String  @id @default(cuid())
  exerciseLogId String
  // 1-based order within the log
  position      Int
  reps          Int
  weight        Float?

  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, position])
}

model SavedExerciseItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("TIME")
  calories    Int
  durationMin Int      @default(0)
  sets        Int?
  reps        Int?
  weight      Float?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ExerciseGoal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("TIME")
  calories    Int      @default(0)
  durationMin Int?
  sets        Int?
  reps        Int?
  weight      Float?
  // Workout rep tempo; null uses the app default
  tempoMs     Int?
  // Free-form notes shown in the plan and during the workout
  notes       String?
  // Bit n set = active on JS getDay() n (0 = Sunday)
  daysMask    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs ExerciseLog[]

  @@index([userId])
}

// Frozen count of planned exercises for a past day, written before the plan
// changes so history isn't rewritten. Days without a row derive from current goals.
model ExercisePlanDay {
  id           String @id @default(cuid())
  userId       String
  // User-local yyyy-MM-dd
  date         String
  plannedCount Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model Goal {
  id               String  @id @default(cuid())
  userId           String  @unique
  calorieGoal      Int     @default(2000)
  proteinGoal      Int     @default(150)
  carbsGoal        Int     @default(250)
  fatGoal          Int     @default(70)
  saturatedFatGoal Int     @default(20)
  healthNotes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AI-written analysis of one Monday-Sunday week, generated by a server job.
// Metrics are computed in code; the AI only writes the text and proposes the
// next week's focus, which the following report checks.
model WeeklyReport {
  id               String  @id @default(cuid())
  userId           String
  // User-local yyyy-MM-dd Monday and Sunday the report covers
  weekStart        String
  weekEnd          String
  // IANA timezone the week's day boundaries were computed in
  timeZone         String
  // Report whose nextWeekFocus this one checked; null on the first report
  previousReportId String? @unique

  // Goals at generation time, since goals can change later
  calorieGoal      Int
  proteinGoal      Int
  carbsGoal        Int
  fatGoal          Int
  saturatedFatGoal Int
  healthNotes      String?

  // Nutrition, averaged over days with food logged
  daysLogged       Int
  avgCalories      Float
  avgProtein       Float
  avgCarbs         Float
  avgFat           Float
  avgSaturatedFat  Float
  calorieDaysOver  Int
  proteinDaysHit   Int
  satFatDaysOver   Int
  healthAlertCount Int

  // Exercise
  exercisesPlanned Int
  exercisesDone    Int
  cardioMinutes    Int
  strengthSessions Int
  exerciseCalories Int

  // Weight averages; weightAvg is null when there were no weigh-ins, and
  // prevWeightAvg covers the week before (or the latest earlier weigh-in)
  weighInCount     Int
  weightAvg        Float?
  prevWeightAvg    Float?

  // JSON detail, shown and sent to the AI but never queried
  dailyBreakdown       String
  topIssues            String
  strengthProgress     String
  // How the previous report's nextWeekFocus went this week, computed in code
  lastWeekFocusResults String?
  // Measurable goals for the week ahead
  nextWeekFocus        String

  // AI output
  headline      String
  // JSON: [{title, points: string[]}]
  narrative     String
  model         String
  promptVersion Int

  // When the user first opened this report, or an older one was covered by a
  // newer one they opened; null shows a "new report" notice on the dashboard
  seenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousReport WeeklyReport? @relation("ReportChain", fields: [previousReportId], references: [id], onDelete: SetNull)
  nextReport     WeeklyReport? @relation("ReportChain")

  @@unique([userId, weekStart])
}
