generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  // Browser-detected IANA timezone, saved so server jobs know the user's local week
  timeZone      String?
  // Last dashboard visit, updated at most hourly
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  foods            FoodLog[]
  savedFoods       SavedFoodItem[]
  exercises        ExerciseLog[]
  savedExercises   SavedExerciseItem[]
  exerciseGoals    ExerciseGoal[]
  exercisePlanDays ExercisePlanDay[]
  weights          WeightLog[]
  bodyMetrics      BodyMetric[]
  goals            Goal?
  profile          Profile?
  weeklyReports    WeeklyReport[]
  chatThreads      ChatThread[]
  chatActions      ChatAction[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FoodLog {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  calories           Float
  protein            Float    @default(0)
  carbs              Float    @default(0)
  fat                Float    @default(0)
  saturatedFat       Float    @default(0)
  // AI health alert shown when the entry was estimated ("caution" | "avoid")
  healthAlertLevel   String?
  healthAlertMessage String?
  loggedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SavedFoodItem {
  id           String   @id @default(cuid())
  userId       String
  name         String
  calories     Float
  protein      Float    @default(0)
  carbs        Float    @default(0)
  fat          Float    @default(0)
  saturatedFat Float    @default(0)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ExerciseLog {
  id             String   @id @default(cuid())
  userId         String
  name           String
  type           String   @default("TIME")
  calories       Int
  durationMin    Int      @default(0)
  sets           Int?
  reps           Int?
  weight         Float?
  loggedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Set when the entry was ticked off from a planned exercise goal
  exerciseGoalId String?
  // User-local yyyy-MM-dd the goal was ticked for; one tick per goal per day
  goalDate       String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseGoal ExerciseGoal? @relation(fields: [exerciseGoalId], references: [id], onDelete: SetNull)
  // Strength sets as done; sets/reps/weight above summarize them (count and top set)
  exerciseSets ExerciseSet[]

  @@unique([exerciseGoalId, goalDate])
  @@index([userId, loggedAt])
}

model ExerciseSet {
  id            String @id @default(cuid())
  exerciseLogId String
  // 1-based order within the log
  position      Int
  // A set is done either for reps or for a time
  reps          Int?
  durationSec   Int?
  weight        Float?

  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, position])
}

model SavedExerciseItem {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("TIME")
  calories    Int
  durationMin Int      @default(0)
  sets        Int?
  reps        Int?
  weight      Float?
  // JSON array of each planned set (reps or durationSec, weight); columns above summarize it
  setPlan     String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model ExerciseGoal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("TIME")
  calories    Int      @default(0)
  durationMin Int?
  sets        Int?
  reps        Int?
  weight      Float?
  // JSON array of each planned set (reps or durationSec, weight); columns above summarize it
  setPlan     String?
  // Workout rep tempo; null uses the app default
  tempoMs     Int?
  // Free-form notes shown in the plan and during the workout
  notes       String?
  // Bit n set = active on JS getDay() n (0 = Sunday)
  daysMask    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs ExerciseLog[]

  @@index([userId])
}

// Frozen count of planned exercises for a past day, written before the plan
// changes so history isn't rewritten. Days without a row derive from current goals.
model ExercisePlanDay {
  id           String @id @default(cuid())
  userId       String
  // User-local yyyy-MM-dd
  date         String
  plannedCount Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// Optional body measurement the user chose to track: a preset (key set) or
// their own label and unit
model BodyMetric {
  id         String    @id @default(cuid())
  userId     String
  // Preset key from lib/body-metrics.ts; null for custom metrics
  key        String?
  label      String
  unit       String
  // Which way is good: "down", "up" or "neutral"
  direction  String    @default("neutral")
  decimals   Int       @default(1)
  sortOrder  Int       @default(0)
  // Archived metrics are hidden but keep their history; null = active
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs BodyMetricLog[]

  @@unique([userId, key])
  @@index([userId])
}

model BodyMetricLog {
  id        String   @id @default(cuid())
  metricId  String
  value     Float
  loggedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  metric BodyMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([metricId, loggedAt])
}

model Goal {
  id               String  @id @default(cuid())
  userId           String  @unique
  calorieGoal      Int     @default(2000)
  proteinGoal      Int     @default(150)
  carbsGoal        Int     @default(250)
  fatGoal          Int     @default(70)
  saturatedFatGoal Int     @default(20)
  healthNotes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AI-written analysis of one Monday-Sunday week, generated by a server job.
// Metrics are computed in code; the AI only writes the text and proposes the
// next week's focus, which the following report checks.
// Details for maintenance calories (lib/tdee.ts). Weight comes from weigh-ins.
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  // "male" | "female"
  sex           String
  // Stored instead of age so it doesn't go stale
  birthYear     Int
  heightCm      Float
  // Optional; switches BMR to Katch-McArdle
  bodyFatPct    Float?
  // Key of ACTIVITY_LEVELS
  activityLevel String
  // Key of FITNESS_GOALS
  goal          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReport {
  id               String  @id @default(cuid())
  userId           String
  // User-local yyyy-MM-dd Monday and Sunday the report covers
  weekStart        String
  weekEnd          String
  // IANA timezone the week's day boundaries were computed in
  timeZone         String
  // Report whose nextWeekFocus this one checked; null on the first report
  previousReportId String? @unique

  // Goals at generation time, since goals can change later
  calorieGoal      Int
  proteinGoal      Int
  carbsGoal        Int
  fatGoal          Int
  saturatedFatGoal Int
  healthNotes      String?

  // Nutrition, averaged over days with food logged
  daysLogged       Int
  avgCalories      Float
  avgProtein       Float
  avgCarbs         Float
  avgFat           Float
  avgSaturatedFat  Float
  calorieDaysOver  Int
  proteinDaysHit   Int
  satFatDaysOver   Int
  healthAlertCount Int

  // Exercise
  exercisesPlanned Int
  exercisesDone    Int
  cardioMinutes    Int
  strengthSessions Int
  exerciseCalories Int

  // Weight averages; weightAvg is null when there were no weigh-ins, and
  // prevWeightAvg covers the week before (or the latest earlier weigh-in)
  weighInCount  Int
  weightAvg     Float?
  prevWeightAvg Float?
  // JSON: averages of the body metrics tracked at generation time; null on
  // reports from before body metrics existed
  bodyMetrics   String?
  // JSON: the user's profile, goal and maintenance calories at generation
  // time; null when they hadn't filled in a profile
  profile       String?

  // JSON detail, shown and sent to the AI but never queried
  dailyBreakdown       String
  topIssues            String
  strengthProgress     String
  // How the previous report's nextWeekFocus went this week, computed in code
  lastWeekFocusResults String?
  // Measurable goals for the week ahead
  nextWeekFocus        String

  // AI output
  headline        String
  // JSON: [{title, points: string[]}]
  narrative       String
  // JSON: string[] of changes to the exercise plan or food goal that suit the
  // user's profile goal; null without a profile
  goalSuggestions String?
  model           String
  promptVersion   Int

  // When the user first opened this report, or an older one was covered by a
  // newer one they opened; null shows a "new report" notice on the dashboard
  seenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousReport WeeklyReport? @relation("ReportChain", fields: [previousReportId], references: [id], onDelete: SetNull)
  nextReport     WeeklyReport? @relation("ReportChain")

  @@unique([userId, weekStart])
}

// A conversation with the AI coach.
model ChatThread {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  actions  ChatAction[]

  @@index([userId, updatedAt])
}

// One message in the model's format, tool calls and results included, so
// later turns can replay the whole context.
model ChatMessage {
  id         String   @id @default(cuid())
  threadId   String
  // "user" | "assistant" | "tool"
  role       String
  content    String?
  // JSON: [{id, name, arguments}] the assistant asked to run
  toolCalls  String?
  // The tool call a "tool" message answers
  toolCallId String?
  createdAt  DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// A log entry the coach proposed; nothing is saved until the user confirms.
model ChatAction {
  id         String    @id @default(cuid())
  threadId   String
  userId     String
  // "food" | "exercise" | "weight" | "plan"
  kind       String
  // JSON: the entry as the log API takes it, or the plan change
  payload    String
  // "pending" | "confirmed" | "dismissed"
  status     String    @default("pending")
  // Id of the log entry created, or the plan goal changed, on confirm
  resultId   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([userId])
}
