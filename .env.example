DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-characters"

# Upstash Redis (required for rate limiting)
# Get these from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Resend (required for email verification)
# Get an API key from https://resend.com
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# AI food estimates (optional)
# Adds an "Estimate" button to the food form that fills in calories and macros
# from a description. Hidden unless BOTH AI_BASE_URL and AI_MODEL are set.
# Also enables Health notes on the Goals page (sent to the AI with estimates).
# Works with any OpenAI-compatible /chat/completions endpoint.
#
# OpenAI:
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY="sk-xxxxxxxx"
# AI_MODEL="gpt-4o-mini"
#
# Local Ollama (no API key needed):
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="llama3.1"

# Weekly AI reports run hourly in the server whenever AI is configured.
# Set to "off" to disable the job (reports already written stay visible).
# WEEKLY_REPORTS="off"

# Demo data (npm run db:seed)
# The timezone the seed counts calendar days in. Set it to your browser's so
# "today" and "last week" in the demo data match the app's. Defaults to UTC.
# SEED_TIMEZONE="Australia/Sydney"
